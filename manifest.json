{
  "manifest_version": 3,
  "name": "LoL Quiz Assistant",
  "description": "Responde preguntas, completa desplegables y coloca palabras en espacios de Moodle.",
  "version": "0.2.5",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>", "http://localhost:8787/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "answer-hovered-question": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Responder la pregunta bajo el cursor o enfocada"
    }
  },
  "action": {
    "default_title": "LoL Quiz Assistant",
    "default_popup": "popup.html"
  }
}
